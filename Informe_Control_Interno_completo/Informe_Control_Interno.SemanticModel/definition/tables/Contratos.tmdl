		sourceColumn: Bandera recursos

	column 'Bandera cierre'
		dataType: int64
		isHidden
		lineageTag: 05ff2f92-6008-4fea-b82d-4af135cb1cd2
		summarizeBy: sum
		sourceColumn: Bandera cierre

	partition Contratos = m
		mode: import
		source =
				let
					Source = Parquet.Document(
				    Binary.Buffer(
				        Web.Contents(
				            "https://raw.githubusercontent.com/jdguzmans/ciencia-de-datos-aplicada-taller-1/master/data/secop_bienes.parquet"
				        	)
				    	)
					),
					Selected = Table.SelectColumns(Source, {"id_contrato", "nombre_entidad", "departamento", "ciudad", "sector", "tipo_de_contrato", "modalidad_de_contratacion", "fecha_de_firma", "fecha_de_fin_del_contrato", "proveedor_adjudicado", "es_pyme", "valor_del_contrato", "valor_pagado", "dias_adicionados", "estado_contrato", "liquidaci_n", "destino_gasto"}),
					Typed = Table.TransformColumnTypes(Selected, {{"id_contrato", type text}, {"nombre_entidad", type text}, {"departamento", type text}, {"ciudad", type text}, {"sector", type text}, {"tipo_de_contrato", type text}, {"modalidad_de_contratacion", type text}, {"fecha_de_firma", type datetime}, {"fecha_de_fin_del_contrato", type datetime}, {"proveedor_adjudicado", type text}, {"es_pyme", type text}, {"valor_del_contrato", type number}, {"valor_pagado", type number}, {"dias_adicionados", Int64.Type}, {"estado_contrato", type text}, {"liquidaci_n", type text}, {"destino_gasto", type text}}, "es-CO"),
					Universe = Table.SelectRows(Typed, each List.Contains({"Cerrado", "terminado", "cedido", "Modificado"}, [estado_contrato]) and [fecha_de_fin_del_contrato] <= #datetime(2025, 12, 31, 0, 0, 0) and [fecha_de_firma] >= #datetime(2020, 1, 1, 0, 0, 0) and [fecha_de_firma] <= #datetime(2024, 12, 31, 23, 59, 59)),
					CleanValue = Table.AddColumn(Universe, "Valor contrato limpio", each if [valor_del_contrato] = 0 or [valor_del_contrato] = 12858450316000000 then null else [valor_del_contrato], type number),
					CleanDays = Table.AddColumn(CleanValue, "Días limpios", each if [dias_adicionados] = 14276 then null else [dias_adicionados], Int64.Type),
					City = Table.AddColumn(CleanDays, "Ciudad normalizada", each if [departamento] = "Distrito Capital de Bogotá" then "Bogotá" else [ciudad], type text),
					FlagTerm = Table.AddColumn(City, "Bandera plazo", each if [Días limpios] <> null and [Días limpios] > 0 then 1 else 0, Int64.Type),
					FlagResources = Table.AddColumn(FlagTerm, "Bandera recursos", each if [valor_pagado] = 0 or ([Valor contrato limpio] <> null and [Valor contrato limpio] > 0 and [valor_pagado] / [Valor contrato limpio] < 0.8) then 1 else 0, Int64.Type),
					FlagClose = Table.AddColumn(FlagResources, "Bandera cierre", each if [liquidaci_n] = "No" then 1 else 0, Int64.Type),
					SectorFocus = Table.AddColumn(FlagClose, "Es foco sector", each List.Contains({"Salud y Protección Social", "Transporte", "agricultura", "Minas y Energía", "Industria", "Ciencia Tecnología", "interior", "Presidencia de la República", "Relaciones Exteriores", "Información Estadística", "deportes", "Ley de Justicia", "Educación Nacional"}, [sector]), type logical),
					ModeFocus = Table.AddColumn(SectorFocus, "Es foco modalidad", each List.Contains({"Contratación régimen especial (con ofertas)", "Contratación régimen especial", "Contratación directa", "Licitación pública"}, [modalidad_de_contratacion]), type logical),
					HighValue = Table.AddColumn(ModeFocus, "Es alto valor", each [Valor contrato limpio] <> null and [Valor contrato limpio] > 78600000, type logical),
					FocusScore = Table.AddColumn(HighValue, "Puntaje de focalización", each Number.From([Es foco sector]) + Number.From([Es foco modalidad]) + Number.From([Es alto valor]), Int64.Type),
					Priority = Table.AddColumn(FocusScore, "Prioridad", each if [Puntaje de focalización] >= 2 then "1. Seguimiento intensivo" else if [Puntaje de focalización] = 1 then "2. Revisión periódica" else "3. Muestra de control", type text),
					PriorityOrder = Table.AddColumn(Priority, "Orden de prioridad", each if [Prioridad] = "1. Seguimiento intensivo" then 1 else if [Prioridad] = "2. Revisión periódica" then 2 else 3, Int64.Type),
					Action = Table.AddColumn(PriorityOrder, "Acción recomendada", each if [Prioridad] = "1. Seguimiento intensivo" then "Supervisión intensiva desde la firma" else if [Prioridad] = "2. Revisión periódica" then "Revisión periódica según criterio" else "Incluir en muestra aleatoria", type text),
					ReviewFocus = Table.AddColumn(Action, "Enfoque de supervisión", each if [destino_gasto] = "Funcionamiento" then "Ejecución de recursos, pagos y obligaciones" else if [destino_gasto] = "Inversión" then "Plazo, entregables y liquidación" else "Clasificación y calidad del registro", type text),
					ValueRange = Table.AddColumn(ReviewFocus, "Rango de valor", each if [Valor contrato limpio] = null then "Sin valor válido" else if [Valor contrato limpio] <= 20900000 then "1. Bajo (≤ $20,9 M)" else if [Valor contrato limpio] <= 78600000 then "2. Medio ($20,9–78,6 M)" else "3. Alto (> $78,6 M)", type text),
					SectorGroup = Table.AddColumn(ValueRange, "Foco sectorial", each if [sector] = "Ley de Justicia" then "Justicia" else if List.Contains({"Salud y Protección Social", "interior", "agricultura", "Transporte"}, [sector]) then [sector] else "Otros sectores", type text),
					ModeGroup = Table.AddColumn(SectorGroup, "Foco de modalidad", each if List.Contains({"Contratación régimen especial (con ofertas)", "Contratación régimen especial", "Contratación directa", "Licitación pública", "Mínima cuantía"}, [modalidad_de_contratacion]) then [modalidad_de_contratacion] else "Otras modalidades", type text),
					DisplayTerm = Table.AddColumn(ModeGroup, "Adición de plazo", each if [Bandera plazo] = 1 then "Sí" else "No", type text),
					DisplayResources = Table.AddColumn(DisplayTerm, "Desviación de recursos", each if [Bandera recursos] = 1 then "Sí" else "No", type text),
					DisplayClose = Table.AddColumn(DisplayResources, "Sin liquidación", each if [Bandera cierre] = 1 then "Sí" else "No", type text),
					Year = Table.AddColumn(DisplayClose, "Año de firma", each Date.Year(DateTime.Date([fecha_de_firma])), Int64.Type),
					Output = Table.RenameColumns(Table.SelectColumns(Year, {"id_contrato", "nombre_entidad", "departamento", "Ciudad normalizada", "sector", "tipo_de_contrato", "modalidad_de_contratacion", "fecha_de_firma", "fecha_de_fin_del_contrato", "proveedor_adjudicado", "es_pyme", "Valor contrato limpio", "valor_pagado", "Días limpios", "estado_contrato", "liquidaci_n", "destino_gasto", "Año de firma", "Foco sectorial", "Foco de modalidad", "Rango de valor", "Enfoque de supervisión", "Puntaje de focalización", "Prioridad", "Orden de prioridad", "Adición de plazo", "Desviación de recursos", "Sin liquidación", "Acción recomendada", "Bandera plazo", "Bandera recursos", "Bandera cierre"}), {{"id_contrato", "ID contrato"}, {"nombre_entidad", "Entidad"}, {"departamento", "Departamento"}, {"Ciudad normalizada", "Ciudad"}, {"sector", "Sector"}, {"tipo_de_contrato", "Tipo de contrato"}, {"modalidad_de_contratacion", "Modalidad de contratación"}, {"fecha_de_firma", "Fecha de firma"}, {"fecha_de_fin_del_contrato", "Fecha de fin"}, {"proveedor_adjudicado", "Proveedor"}, {"es_pyme", "Es pyme"}, {"Valor contrato limpio", "Valor del contrato"}, {"valor_pagado", "Valor pagado"}, {"Días limpios", "Días adicionados"}, {"estado_contrato", "Estado"}, {"liquidaci_n", "Liquidado"}, {"destino_gasto", "Destino del gasto"}}),
					FinalTypes = Table.TransformColumnTypes(Output, {{"Valor del contrato", Currency.Type}, {"Valor pagado", Currency.Type}}, "es-CO")
				in
					FinalTypes

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

