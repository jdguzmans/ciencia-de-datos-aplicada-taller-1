/// Contratos de compraventa y suministro incluidos en el universo histórico de seguimiento.
table Contratos
	lineageTag: a9b8702c-ceb2-4edc-8e2e-a238a9dfb149

	/// Número de contratos que cumplen los criterios del análisis.
	measure 'Contratos analizados' = COUNTROWS(Contratos)
		formatString: #,##0
		displayFolder: Resumen
		lineageTag: 794eea0c-b23b-49f1-ae0a-aec145cbd760

	/// Número de contratos visible después de aplicar filtros.
	measure 'Contratos seleccionados' = COUNTROWS(Contratos)
		formatString: #,##0
		displayFolder: Selección
		lineageTag: fa88feb4-4a0f-499a-a004-af1eda8cd588

	/// Proporción de contratos con días adicionales al plazo inicialmente pactado.
	measure '% con adición de plazo' = DIVIDE(SUM(Contratos[Bandera plazo]), COUNTROWS(Contratos))
		formatString: 0.0%
		displayFolder: Incidencia
		lineageTag: f52c8f91-7072-491b-a583-b19c3d5989f7

	/// Proporción de contratos sin pago o con ejecución inferior al 80 por ciento del valor contractual.
	measure '% con desviación de recursos' = DIVIDE(SUM(Contratos[Bandera recursos]), COUNTROWS(Contratos))
		formatString: 0.0%
		displayFolder: Incidencia
		lineageTag: 21bec612-4403-47d7-b927-c6d1254d0c66

	/// Proporción de contratos que no registran liquidación.
	measure '% sin liquidación' = DIVIDE(SUM(Contratos[Bandera cierre]), COUNTROWS(Contratos))
		formatString: 0.0%
		displayFolder: Incidencia
		lineageTag: 790eb4f3-12aa-4470-b36a-f55bb426dccb

	/// Número de contratos que reúnen al menos dos criterios entre sector, modalidad y alto valor.
	measure 'Contratos prioridad 1' = CALCULATE(COUNTROWS(Contratos), Contratos[Prioridad] = "1. Seguimiento intensivo")
		formatString: #,##0
		displayFolder: Priorización
		lineageTag: 2e6c68f3-f45d-42a4-a9b7-59b7603a2e62

	/// Valor de los contratos visibles después de aplicar filtros.
	measure 'Valor contractual seleccionado' = SUM(Contratos[Valor del contrato])
		formatString: $ #,##0
		displayFolder: Selección
		lineageTag: 0ea186f7-4222-4f1e-9c51-a4cb657c9623

		annotation PBI_FormatHint = {"isCustom":true}

	/// Valor contractual asociado al nivel de seguimiento intensivo.
	measure 'Valor prioridad 1' = CALCULATE(SUM(Contratos[Valor del contrato]), Contratos[Prioridad] = "1. Seguimiento intensivo")
		formatString: $ #,##0
		displayFolder: Priorización
		lineageTag: fac6a956-8fb6-495e-a138-479f9292ff72

		annotation PBI_FormatHint = {"isCustom":true}

